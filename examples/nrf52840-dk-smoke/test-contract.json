{
  "schema_version": "1.0",
  "name": "nrf52840-dk-smoke",
  "board": "Nordic nRF52840 DK",
  "target": "nRF52840_xxAA",
  "debug": {
    "probe": "1366:1061:001050275757",
    "operation": "snapshot.reset-capture",
    "automatic_retries": 0
  },
  "firmware": {
    "build_script": "build.ps1",
    "format": "hex",
    "runtime_identity": {
      "line_prefix": "EAT_NRF52840_DK_BUILD_ID v1 ",
      "source_manifest_sha256_bound": true,
      "artifact_sha256_attestation": false
    },
    "allowed_code_flash": {
      "start": "0x00000000",
      "end_exclusive": "0x00100000"
    },
    "allowed_non_boot_nvm": [
      {
        "name": "UICR.APPROTECT",
        "start": "0x10001208",
        "end_exclusive": "0x1000120C",
        "value": "0x0000005A",
        "effect": "development debug access remains enabled"
      }
    ],
    "preserve_unwritten_uicr_bytes": true
  },
  "flash": {
    "exact_probe_selector_required": true,
    "exact_confirmation_digest_required": true,
    "automatic_retries": 0
  },
  "serial": {
    "exact_port_identity_required": true,
    "port": "COM11",
    "usb_vendor_id": "1366",
    "usb_product_id": "1061",
    "usb_serial_number": "001050275757",
    "usb_interface": null,
    "baud": 115200,
    "data_bits": 8,
    "parity": "none",
    "stop_bits": 1,
    "flow_control": "none",
    "dtr": true,
    "rts": false,
    "transmit_bytes": 0,
    "observe_duration_seconds": 15,
    "monitor_startup_delay_ms": 400,
    "ready_line": "EAT_NRF52840_DK_READY v1",
    "build_id_line": "EAT_NRF52840_DK_BUILD_ID v1 bfb6b26450ddfcd5049a0423f975c384f16ac12264c3a88068c0e04a810db05c",
    "heartbeat_line": "EAT_NRF52840_DK_HEARTBEAT",
    "minimum_complete_heartbeats": 3,
    "forbidden_complete_lines": [
      "EAT_NRF52840_DK_FAULT",
      "EAT_NRF52840_DK_PANIC"
    ]
  },
  "visual": {
    "led": "LED1",
    "pin": "P0.13",
    "active_low": true,
    "expected": "toggles repeatedly"
  },
  "abort_conditions": [
    "probe identity differs",
    "target differs",
    "firmware hash differs from the reviewed plan",
    "plan includes a non-boot NVM write other than UICR.APPROTECT=0x0000005A",
    "plan does not preserve every unwritten UICR byte",
    "serial port identity is ambiguous",
    "any state-changing stage returns an indeterminate result"
  ],
  "cleanup": {
    "close_serial_session": true,
    "disconnect_debug_session": true,
    "do_not_retry_state_changing_failures": true
  }
}
